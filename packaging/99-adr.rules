# Optional udev rule for Automatic Disc Ripper for Proxmox.
# Inspired by the Automatic Ripping Machine udev rules:
# https://github.com/automatic-ripping-machine/automatic-ripping-machine
#
# ADR itself polls /dev/sr* every 3 s via the CDROM_DRIVE_STATUS ioctl,
# so strictly speaking this file is not required.  Install it if you want:
#   - instant syslog entries on disc insertion for troubleshooting, or
#   - to plug in a custom RUN+ action (e.g. notify Home Assistant).
#
# Install with:
#   sudo install -m 644 packaging/99-adr.rules /etc/udev/rules.d/99-adr.rules
#   sudo udevadm control --reload-rules

ACTION=="change", KERNEL=="sr[0-9]*", SUBSYSTEM=="block", \
    ENV{DISK_EJECT_REQUEST}!="1", ENV{ID_CDROM_MEDIA}=="1", \
    RUN+="/usr/bin/logger -t adr 'disc inserted in %k (label=$env{ID_FS_LABEL})'"

ACTION=="change", KERNEL=="sr[0-9]*", SUBSYSTEM=="block", \
    ENV{DISK_EJECT_REQUEST}=="1", \
    RUN+="/usr/bin/logger -t adr 'eject requested on %k'"
