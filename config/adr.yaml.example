# Automatic Disc Ripper — example configuration.
#
# Copy to config/adr.yaml and edit, or edit everything from the web UI under
# Settings. Every key here is also a default, so anything you delete simply
# falls back to the value shown.

# --- Audio CDs -------------------------------------------------------------
# An audio CD has no video titles, so it takes its own path: cdparanoia
# extracts each track, ffmpeg encodes and tags it, and MusicBrainz supplies the
# artist, album and track names. music_path empty means completed_path/Music.
audio_cd_enabled: true
audio_cd_format: flac          # flac | mp3
audio_cd_mp3_bitrate: 320k
cdparanoia_path: /usr/bin/cdparanoia
ffmpeg_path: /usr/bin/ffmpeg
music_path: ''

# --- Data discs ------------------------------------------------------------
# Nothing to transcode, so the disc is kept as a byte-for-byte ISO image.
# data_disc_path empty means completed_path/ISO.
data_disc_enabled: true
data_disc_path: ''

# --- Which program does the encoding ---------------------------------------
# "handbrake" is the default and the one with the presets.
#
# "vaapi" hands the job to ffmpeg and the GPU instead. It exists because a
# container can have a perfectly working Intel GPU that HandBrake cannot reach:
# HandBrake's Quick Sync path goes through the Intel Media SDK, which is
# deprecated and no longer starts on current drivers, while VA-API — the same
# hardware by a different road — works fine. The Doctor page's encoder test
# tries both and offers the switch when it applies.
#
# HandBrake presets do not apply to the GPU path; these four settings are what
# VA-API actually exposes.
# --- What you want out, whichever encoder runs -----------------------------
# Both HandBrake and the ffmpeg/GPU path are told about these three, so
# switching encoder does not silently change the result. Left at their defaults
# they change nothing: HandBrake keeps every value in its preset.
audio_language: ''             # swe | eng | sv | '' — '' keeps the disc's order
video_quality: 0               # quantiser, lower is better; 0 = leave it alone
max_height: 0                  # 0 = the source; 1080 shrinks a 4K rip
encoder_backend: handbrake     # handbrake | vaapi
# Which VA-API driver HandBrake's Quick Sync should load, via
# LIBVA_DRIVER_NAME. Empty leaves libva to choose, which is right on a machine
# with one driver installed and can be wrong on a container with several: the
# Media SDK is built against a particular one, and libva picking the other
# looks exactly like having no GPU. The encoder test tries each and fills it in.
libva_driver: ''               # '' | iHD | i965
vaapi_codec: h264              # h264 | hevc
vaapi_device: ''               # empty means the first render node found

auto_move_to_plex: true
completed_path: /opt/adr/completed
disabled_drives: []
drive_labels: {}
drives: auto
eject_after_rip: true
handbrake_extra_args: ''
handbrake_path: /usr/bin/HandBrakeCLI
handbrake_preset: Fast 1080p30
handbrake_preset_file: ''
log_level: INFO
# Where the service log and per-job logs are written. Empty means a logs/
# folder beside the database — on the container's own disk, never the NAS,
# which would mean a network write per log line.
log_path: ''
main_feature_only: true
makemkv_path: /usr/bin/makemkvcon
max_encode_jobs: 1
min_title_length: 120
no_eject_drives: []
notify_enabled: false
notify_events:
- job_done
- job_failed
notify_provider: ntfy
notify_token: ''
notify_url: ''
plex_path: ''
plex_refresh_enabled: false
plex_section: ''
plex_token: ''
plex_url: ''
raw_path: /opt/adr/raw
require_completed_mount: false
series_detection: true
series_max_minutes: 75
series_min_episodes: 3
series_min_minutes: 15
series_mode: false
series_mode_discs: 0
series_mode_next_episode: 1
series_mode_season: 1
series_mode_show: ''
series_mode_tmdb_id: null
series_mode_year: null
skip_duplicates: false
stage_locally: true
staging_path: /opt/adr/staging
tmdb_api_key: ''
# Off keeps the MKV as MakeMKV produced it: lossless, fast, several times larger.
transcode_enabled: true
tv_path: ''
watch_interval: 5
watch_output_path: ''
watch_path: ''
web_host: 0.0.0.0
web_port: 8080
