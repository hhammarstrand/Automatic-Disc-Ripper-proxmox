# Automatic Disc Ripper — example configuration.
#
# Copy to config/adr.yaml and edit, or edit everything from the web UI under
# Settings. Every key here is also a default, so anything you delete simply
# falls back to the value shown.
#
# The sections below are the ones on the Settings page, in the same order.


# --------------------------------------------------------------------------
# Library — where things end up
# --------------------------------------------------------------------------
# Where finished films go. /opt/adr/completed keeps them on the container;
# /mnt/media is where a NAS or host storage is mounted. The raw rip and the
# staging folder stay on the container's own disk either way, so a slow share
# never becomes the encoder's bottleneck.
#
# Plex keeps films and shows in separate libraries with different naming rules,
# so tv_path exists to stop a season folder landing in the movie library.

completed_path: /opt/adr/completed
raw_path: /opt/adr/raw
staging_path: /opt/adr/staging
stage_locally: true
plex_path: ''
tv_path: ''
music_path: ''
data_disc_path: ''
auto_move_to_plex: true
require_completed_mount: false
skip_duplicates: false

# --------------------------------------------------------------------------
# Encoding — what you want out, and what does the work
# --------------------------------------------------------------------------
# The first three describe the *result* and are told to whichever encoder runs,
# so switching encoder does not silently change what you get. Each has a
# "leave it alone" value, and that is the default: nothing here overrides a
# HandBrake preset unless it is asked to.
#
# encoder_backend picks the tool. "vaapi" hands the job to ffmpeg and the GPU,
# which exists because a container can have a perfectly working Intel GPU that
# HandBrake cannot reach — its Quick Sync path goes through the deprecated Media
# SDK. The Doctor page's encoder test tries both and offers the switch.

audio_language: ''                          # swe | eng | sv | '' uses the preset's language, or the disc's order if it names none
video_quality: 0                            # quantiser, lower is better; 0 leaves it to the preset
max_height: 0                               # 0 = the source; 1080 shrinks a 4K rip. Never upscales
encoder_backend: handbrake                  # handbrake | vaapi
transcode_enabled: true                     # off keeps the MKV as MakeMKV produced it
handbrake_preset: Fast 1080p30
handbrake_preset_file: ''
handbrake_extra_args: ''
libva_driver: ''                            # '' | iHD | i965 — '' lets libva choose
vaapi_codec: h264                           # h264 | hevc
vaapi_device: ''                            # empty means the first render node found
max_encode_jobs: 1

# --------------------------------------------------------------------------
# Discs — reading them
# --------------------------------------------------------------------------
# An audio CD has no video titles and a data disc has nothing to transcode, so
# both take their own path rather than being handed to MakeMKV, which fails on
# them in a way indistinguishable from a broken drive.
#
# The series thresholds are a judgement, not a fact: anime runs to 24 minutes, a
# documentary series to 55, and some box set will sit outside any default.
# Detection only ever suggests — you confirm on the dashboard before encoding.

drives: auto                                # auto, or a list of device paths
disabled_drives: []
drive_labels: {}
no_eject_drives: []
eject_after_rip: true
min_title_length: 120
main_feature_only: true
series_detection: true
series_min_minutes: 15
series_max_minutes: 75
series_min_episodes: 3
series_mode: false
series_mode_show: ''
series_mode_year: null
series_mode_tmdb_id: null
series_mode_season: 1
series_mode_next_episode: 1
series_mode_discs: 0
audio_cd_enabled: true
audio_cd_format: flac                       # flac | mp3
audio_cd_mp3_bitrate: 320k
data_disc_enabled: true

# --------------------------------------------------------------------------
# Integrations — the things outside this container
# --------------------------------------------------------------------------
# The pipeline is meant to be unattended, so a failure forty minutes ago has to
# reach you rather than wait on a dashboard nobody is looking at.
#
# notify_url is a credential for several providers — an ntfy topic anyone who
# knows it can read — which is why the diagnostics bundle redacts it.

tmdb_api_key: ''
plex_refresh_enabled: false
plex_url: ''
plex_token: ''
plex_section: ''
notify_enabled: false
notify_provider: ntfy                       # ntfy | gotify | discord | webhook
notify_url: ''
notify_token: ''
notify_events: [job_done, job_failed]
watch_path: ''
watch_output_path: ''
watch_interval: 5

# --------------------------------------------------------------------------
# Advanced — rarely touched
# --------------------------------------------------------------------------
# The installer sets the tool paths and they are almost never wrong. log_path
# empty means a logs/ folder beside the database, on the container's own disk —
# never the NAS, which would mean a network write per log line.

web_host: 0.0.0.0
web_port: 8080
log_level: INFO                             # DEBUG | INFO | WARNING | ERROR
log_path: ''
makemkv_path: /usr/bin/makemkvcon
handbrake_path: /usr/bin/HandBrakeCLI
ffmpeg_path: /usr/bin/ffmpeg
cdparanoia_path: /usr/bin/cdparanoia
